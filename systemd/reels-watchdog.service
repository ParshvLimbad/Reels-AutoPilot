[Unit]
Description=Reels AutoPilot Watchdog
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=electro
WorkingDirectory=/home/electro/reels-autopilot
ExecStart=/home/electro/reels-autopilot/venv/bin/python3 /home/electro/reels-autopilot/watchdog.py
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
