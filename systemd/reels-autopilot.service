[Unit]
Description=Reels AutoPilot Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__RUN_USER__
WorkingDirectory=__PROJECT_DIR__/src
Environment=PYTHONUNBUFFERED=1
ExecStart=__PROJECT_DIR__/venv/bin/python3 __PROJECT_DIR__/src/app.py
Restart=always
RestartSec=15
KillSignal=SIGTERM
TimeoutStopSec=150
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
