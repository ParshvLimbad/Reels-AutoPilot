[Unit]
Description=Reels AutoPilot - Web Dashboard
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/reels-autopilot
ExecStart=/home/pi/reels-autopilot/venv/bin/python src/web.py
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1
Environment=PORT=8080

[Install]
WantedBy=multi-user.target
