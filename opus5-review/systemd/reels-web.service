[Unit]
Description=Reels AutoPilot Web Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=electro
WorkingDirectory=/home/electro/reels-autopilot/src
Environment=PORT=8080
ExecStart=/home/electro/reels-autopilot/venv/bin/python3 /home/electro/reels-autopilot/src/web.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
