[Unit]
Description=Reels AutoPilot isolated media service
After=network-online.target
Wants=network-online.target
[Service]
User=electro
WorkingDirectory=/home/electro/reels-autopilot
ExecStart=/home/electro/reels-autopilot/venv/bin/python /home/electro/reels-autopilot/src/media_tunnel.py
Restart=on-failure
RestartSec=15
Environment=GOMEMLIMIT=50MiB
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
MemoryMax=110M
[Install]
WantedBy=multi-user.target
